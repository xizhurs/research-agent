# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
# Real environment variables take priority over values in .env.

# Optional. Without it OpenAlex gives a small shared anonymous daily budget.
# Free key: https://openalex.org/settings/api
OPENALEX_API_KEY=your-openalex-api-key

# Needed once the LLM is used (milestone M2).
OPENAI_API_KEY=your-openai-api-key

# Optional login for `research-agent ui` (set both, or neither). Strongly recommended when the
# server is reachable by others, e.g. on Render.
# UI_USERNAME=choose-a-username
# UI_PASSWORD=choose-a-long-password

# Optional tracing to Langfuse (set all three, or none). The question, answer, prompts and tool
# results are sent too; set RESEARCH_AGENT_TRACE_CONTENT=false to send metadata only.
# Needs: uv sync --extra tracing (the Docker image includes it).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# RESEARCH_AGENT_TRACE_CONTENT=true

# Optional: the evaluation judge (research-agent eval judge --live), an Anthropic model.
# Needs: uv sync --extra judge. CLAUDE_MODEL overrides [eval.judge] model in the config.
# CLAUDE_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-haiku-5-5
